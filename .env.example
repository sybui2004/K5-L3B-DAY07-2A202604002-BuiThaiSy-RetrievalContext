# Copy to .env (cp .env.example .env) and fill in. .env is git-ignored; never commit it.

# --- Agent LLM: DeepSeek (OpenAI-compatible API) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Check the exact model ID for V4 Flash in the DeepSeek docs / model list, then set it here.
DEEPSEEK_MODEL=

# --- Day 6 vector store (PostgreSQL + pgvector, docker compose from the Day 6 repo) ---
# Host port is 15433 because Windows reserves 55433 on this machine.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:15433/day6_lab

# --- Day 6 embedding (must match the index: bge-m3, 1024 dims) ---
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
